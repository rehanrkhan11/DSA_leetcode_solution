class Solution {
    public int romanToInt(String s) {
        HashMap<Character,Integer> mp=new HashMap<>();

        mp.put('I',1);
        mp.put('V',5);
        mp.put('X',10);
        mp.put('L',50);
        mp.put('C',100);
        mp.put('D',500);
        mp.put('M',1000);
        int sum=0;


        for(int i=0;i<s.length()-1;i++){
            char ch=s.charAt(i);
            char ch2=s.charAt(i+1);
            if(mp.get(ch)<mp.get(ch2)){
                sum-=mp.get(ch);
            }else{
                sum+=mp.get(ch);
            }

        }
        sum+=mp.get(s.charAt(s.length()-1));

        return sum;
        
    }
}
