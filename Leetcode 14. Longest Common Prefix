class Solution {
    public String longestCommonPrefix(String[] strs) {
        Arrays.sort(strs);
        String first=strs[0];
        String last=strs[strs.length-1];
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<first.length();i++){
            char ch1=first.charAt(i);
            char ch2=last.charAt(i);

            if(ch1==ch2){
                sb.append(ch1);
            }
            else{
                break;
            }


        }
        return sb.toString();


        
    }
}
